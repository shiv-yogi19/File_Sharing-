{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluxdrop",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node -e \"const f=require('fs');['crypto','watermark'].forEach(n=>f.copyFileSync('src/'+n+'.js','public/'+n+'.js'))\"" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/ws"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
